{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AV Library Manager",
  "version": "0.13.0",
  "identifier": "local.avlibrary.manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "appDirectoriesOverride": "./app-data",
    "windows": [
      {
        "title": "映库",
        "width": 1360,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "theme": "Light",
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/covers/**",
          "$APPDATA/thumbnails/**"
        ]
      }
    }
  },
  "bundle": {
    "active": false
  }
}
